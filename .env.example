# Copy file này thành ".env" rồi điền key thật vào

# Chọn nhà cung cấp LLM dùng cho bước 3-6 (dịch + bản địa hóa):
# "gemini" (Google chính chủ) | "anthropic" (Anthropic chính chủ) | "openai_compatible" (proxy bên thứ 3)
LLM_PROVIDER=openai_compatible

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Provider dạng OpenAI-compatible (VD: shopaikey.com) ---
# ⚠️ Dán key thật vào ĐÂY (file .env, không commit lên GitHub), KHÔNG dán vào chat/nơi công khai.
# Nếu key từng bị dán ra ngoài (kể cả trong chat AI), nên thu hồi và tạo key mới trước khi dùng thật.
OPENAI_COMPAT_API_KEY=your_key_here
# Dùng đúng endpoint nhóm "OpenAI" trên dashboard shopaikey.com (không dùng nhóm Google GenAI/
# Anthropic vì SDK khác, và không dùng "DIRECT" vì đó chỉ dành cho tác vụ dễ timeout như tạo ảnh)
OPENAI_COMPAT_BASE_URL=https://api.shopaikey.com/v1
OPENAI_COMPAT_MODEL=gemini-3.7-flash

# faster-whisper: medium | small | distil-large-v3 (khuyến nghị cho GPU 6GB)
WHISPER_MODEL_SIZE=distil-large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8

# Thư mục lưu job (transcript, bản dịch, audio, video xuất ra)
JOBS_DIR=./jobs
